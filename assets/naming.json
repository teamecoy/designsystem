{
  "$comment": "GENERATED by assets/build_naming.py from assets/source/Ecoy_Photography_Filename_Generator.xlsx. Do not hand-edit; edit the spreadsheet and re-run.",
  "version": "1.0",
  "library": {
    "master": "Google Drive, Ecoy shared drive",
    "root": "Photography",
    "rootFolderId": "18qRGqMBgXvmb-tKALvXgkPHhYuH6Setz",
    "rootUrl": "https://drive.google.com/drive/folders/18qRGqMBgXvmb-tKALvXgkPHhYuH6Setz",
    "note": "The repository never stores photography. Name the asset you need using the pattern below and pull it from Drive.",
    "cdn": {
      "pattern": "https://cdn.shopify.com/s/files/1/0498/6100/1367/files/{filename}",
      "note": "Every image in library-index.json whose name appears in shopify-upload-manifest.json is on the Shopify CDN under this pattern. Shopify preserved filenames exactly (0 renames across 6,340 uploads), so the url is derivable from the filename - no lookup table needed. Use these urls in email, ads and web; they need no auth and are not rate limited.",
      "uploaded": "2026-09-22, 6340 of 6350 files"
    },
    "anglePreference": {
      "heroAndAds": "High45",
      "note": "High45 is the preferred angle for advertising and hero creative. When several frames of the same product and colour are available, rank High45 first, then Low45, then Side. Sam's rule, 2026-09-21."
    },
    "web": {
      "root": "Photography - Web",
      "rule": "Same relative path and filename stem as the master; only the root folder and the extension change.",
      "extension": ".webp",
      "longestEdge": 2400,
      "quality": 78,
      "typicalSize": "~237 KB, up to ~900 KB for texture-heavy close-ups, versus ~24 MB for a master",
      "preserves": "aspect ratio exactly, ICC colour profile, EXIF rotation baked in",
      "sourceExtensions": [
        ".jpg",
        ".jpeg",
        ".png",
        ".tif",
        ".tiff"
      ],
      "excludedFolders": [
        "NEW IMAGERY - to be renamed",
        "Archive",
        "Founder BTS & OLD Content"
      ],
      "useFor": "screen work, mockups, anything on the web. Masters stay the source of truth for print and retouching.",
      "missingMeans": "not generated yet, not absent. Fall back to the master rather than erroring.",
      "hotlinking": "none. These are Drive files with no CDN in front of them, so they still cannot be referenced by URL from a published page."
    }
  },
  "filename": {
    "pattern": "{product}-{pattern}-{colour}-{angle}-{people}-{source}-{seq}{ext}",
    "separator": "-",
    "example": "BambooSheetSet-Solid-Dusk-High45-NoTalent-Real-01.jpg",
    "exampleCombo": "BambooSheetSet-Solid-BurntOrangexWhite-High45-NoTalent-AI-01.jpg",
    "fields": {
      "product": {
        "required": true,
        "from": "products"
      },
      "pattern": {
        "required": false,
        "from": "patterns",
        "omitWhen": "the product has no pattern (quilts, pillows, protector)"
      },
      "colour": {
        "required": false,
        "from": "colours",
        "omitWhen": "the product has no colourway",
        "combo": true
      },
      "angle": {
        "required": true,
        "from": "angles"
      },
      "people": {
        "required": true,
        "from": "people"
      },
      "source": {
        "required": true,
        "from": "sources"
      },
      "seq": {
        "required": true,
        "format": "two digits, zero padded, 01 upward"
      },
      "ext": {
        "required": true,
        "from": "extensions"
      }
    },
    "comboColour": {
      "rule": "A two-colour shot joins both tokens with a lowercase x and no spaces.",
      "format": "{colourA}x{colourB}",
      "example": "BurntOrangexWhite",
      "note": "Not in the spreadsheet dropdowns; built by hand. Order follows the Drive folder name."
    }
  },
  "drivePath": {
    "pattern": "Photography/{Product display}/{Pattern}/{Colour folder}/{Talent folder}/{filename}",
    "talentFolders": {
      "NoTalent": "No Talent",
      "Talent": "Talent"
    },
    "note": "Folder names are human-formatted and keep spaces (Burnt Orange, No Talent). Filename tokens strip them (BurntOrange, NoTalent). Compare with spaces removed and case ignored."
