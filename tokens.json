{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Ecoy design tokens v0.1. Generated by scripts/build_tokens.py. Sources: Ecoy Rebrand 2026 V2 brand guide, Tag & Chip Spec v0.1.",
  "color": {
    "deep-green": {
      "$type": "color",
      "$value": "#004C39",
      "$extensions": {
        "com.ecoy": {
          "name": "Deep Green",
          "cmyk": [
            100,
            0,
            35,
            57
          ],
          "source": "guide p17"
        }
      },
      "$description": "Primary dark ground. Headings on light, hero and footer fills, primary CTA, newness tags, active filter pills."
    },
    "off-white": {
      "$type": "color",
      "$value": "#F6F2E8",
      "$extensions": {
        "com.ecoy": {
          "name": "Off White",
          "cmyk": [
            0,
            2,
            6,
            4
          ],
          "source": "guide p17"
        }
      },
      "$description": "Primary light ground. Page background, text on dark grounds, light CTA on dark."
    },
    "bright-orange": {
      "$type": "color",
      "$value": "#FF6301",
      "$extensions": {
        "com.ecoy": {
          "name": "Bright Orange",
          "cmyk": [
            0,
            61,
            100,
            0
          ],
          "source": "guide p17"
        }
      },
      "$description": "Accent only, never a foundation. Eyebrows, hand-drawn accents, value tags (discounts, best seller)."
    },
    "burgundy": {
      "$type": "color",
      "$value": "#A30042",
      "$extensions": {
        "com.ecoy": {
          "name": "Burgundy Red",
          "cmyk": [
            0,
            86,
            54,
            32
          ],
          "source": "guide p17"
        }
      },
      "$description": "Expressive campaign colour. Urgency tags (sale, last chance, low stock)."
    },
    "light-green": {
      "$type": "color",
      "$value": "#A3C2A7",
      "$extensions": {
        "com.ecoy": {
          "name": "Light Green",
          "cmyk": [
            16,
            0,
            14,
            24
          ],
          "source": "guide p17"
        }
      },
      "$description": "Soft ground and pillar-shape fill; pairs with Deep Green and Deep Blue."
    },
    "light-blue": {
      "$type": "color",
      "$value": "#A5CAD9",
      "$extensions": {
        "com.ecoy": {
          "name": "Light Blue",
          "cmyk": [
            24,
            2,
            0,
            14
          ],
          "source": "guide p17"
        }
      },
      "$description": "Soft ground; pairs with Deep Blue."
    },
    "light-pink": {
      "$type": "color",
      "$value": "#FFBAB5",
      "$extensions": {
        "com.ecoy": {
          "name": "Light Pink",
          "cmyk": [
            0,
            27,
            29,
            0
          ],
          "source": "guide p17"
        }
      },
      "$description": "Soft ground and pillar-shape fill; pairs with Burgundy and Chocolate."
    },
    "chocolate": {
      "$type": "color",
      "$value": "#583200",
      "$extensions": {
        "com.ecoy": {
          "name": "Chocolate Brown",
          "cmyk": [
            0,
            43,
            100,
            65
          ],
          "source": "guide p17"
        }
      },
      "$description": "Warm dark ground; pairs with Light Pink."
    },
    "deep-blue": {
      "$type": "color",
      "$value": "#0F6A91",
      "$extensions": {
        "com.ecoy": {
          "name": "Deep Blue",
          "cmyk": [
            90,
            27,
            0,
            43
          ],
          "source": "guide p17"
        }
      },
      "$description": "Cool dark ground; pairs with Light Blue and Light Green."
    },
    "charcoal": {
      "$type": "color",
      "$value": "#1C1C1C",
      "$extensions": {
        "com.ecoy": {
          "name": "Charcoal Black",
          "cmyk": [
            0,
            0,
            0,
            89
          ],
          "source": "guide p17"
        }
      },
      "$description": "Near-black ink and monochrome ground. Body text on light, high-contrast alt on orange."
    },
    "neutral-fill": {
      "$type": "color",
      "$value": "#E9E5DB",
      "$extensions": {
        "com.ecoy": {
          "name": "Neutral fill",
          "source": "derived",
          "status": "tbc"
        }
      },
      "$description": "Filter pill at rest. Spec says 'pull from live site'; this is an Off White shade proposed until confirmed."
    },
    "neutral-fill-hover": {
      "$type": "color",
      "$value": "#D8D3C6",
      "$extensions": {
        "com.ecoy": {
          "name": "Neutral fill hover",
          "source": "derived",
          "status": "tbc"
        }
      },
      "$description": "Filter pill hover: neutral fill darkened ~8% per spec proposal."
    },
    "deep-green-hover": {
      "$type": "color",
      "$value": "#003D2E",
      "$extensions": {
        "com.ecoy": {
          "name": "Deep Green hover",
          "source": "derived",
          "status": "tbc"
        }
      },
      "$description": "Primary CTA and active pill hover: Deep Green darkened ~8%."
    },
    "white": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$extensions": {
        "com.ecoy": {
          "name": "White",
          "source": "derived"
        }
      },
      "$description": "Text on saturated tag fills. Pure white, not Off White, so the spec's contrast ratios hold."
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Malinton",
        "Fredoka",
        "Nunito",
        "system-ui",
        "sans-serif"
      ],
      "$description": "Primary. Headlines, subheads, body, campaign, packaging. Default everywhere."
    },
    "text": {
      "$type": "fontFamily",
      "$value": [
        "Satoshi",
        "Inter",
        "system-ui",
        "-apple-system",
        "sans-serif"
      ],
      "$description": "Supporting. Small sizes, dense information, legibility-critical, all tags and functional UI text. Inter is the Google-safe stand-in, mandatory in EDM."
    }
  },
  "typography": {
    "rules": {
      "line-height": {
        "$type": "number",
        "$value": 1.2
      },
      "line-height-legible": {
        "$type": "number",
        "$value": 1.4
      },
      "letter-spacing": {
        "$type": "dimension",
        "$value": "-0.02em"
      }
    },
    "h1": {
      "$type": "typography",
      "$description": "Page and hero headings",
      "desktop": {
        "$value": {
          "fontFamily": "{font.display}",
          "fontSize": "40px",
          "fontWeight": 700,
          "lineHeight": 1.2,
          "letterSpacing": "-0.02em"
        }
      },
      "mobile": {
        "$value": {
          "fontFamily": "{font.display}",
          "fontSize": "32px",
          "fontWeight": 700,
          "lineHeight": 1.2,
          "letterSpacing": "-0.02em"
        }
      }
    },
    "h2": {
      "$type": "typography",
      "$description": "Section headings",
      "desktop": {
        "$value": {
          "fontFamily": "{font.display}",
          "fontSize": "28px",
          "fontWeight": 700,
          "lineHeight": 1.2,
          "letterSpacing": "-0.02em"
        }
      },
      "mobile": {
        "$value": {
          "fontFamily": "{font.display}",
          "fontSize": "24px",
          "fontWeight": 700,
          "lineHeight": 1.2,
          "letterSpacing": "-0.02em"
        }
      }
    },
    "h3": {
      "$type": "typography",
      "$description": "Card and product titles",
      "desktop": {
        "$value": {
          "fontFamily": "{font.display}",
          "fontSize": "20px",
          "fontWeight": 600,
          "lineHeight": 1.2,
          "letterSpacing": "-0.02em"
        }
      },
      "mobile": {
        "$value": {
          "fontFamily": "{font.display}",
          "fontSize": "18px",
          "fontWeight": 600,
          "lineHeight": 1.2,
          "letterSpacing": "-0.02em"
        }
      }
    },
    "body": {
      "$type": "typography",
      "$description": "Paragraphs, descriptions",
      "desktop": {
        "$value": {
          "fontFamily": "{font.text}",
          "fontSize": "16px",
          "fontWeight": 400,
          "lineHeight": 1.2,
          "letterSpacing": "-0.02em"
        }
      },
      "mobile": {
        "$value": {
          "fontFamily": "{font.text}",
          "fontSize": "15px",
          "fontWeight": 400,
          "lineHeight": 1.2,
          "letterSpacing": "-0.02em"
        }
      }
    },
    "price": {
      "$type": "typography",
      "$description": "Prices",
      "desktop": {
        "$value": {
          "fontFamily": "{font.text}",
          "fontSize": "16px",
          "fontWeight": 600,
          "lineHeight": 1.2,
          "letterSpacing": "-0.02em"
        }
      },
      "mobile": {
        "$value": {
          "fontFamily": "{font.text}",
          "fontSize": "15px",
          "fontWeight": 600,
          "lineHeight": 1.2,
          "letterSpacing": "-0.02em"
        }
      }
    },
    "small": {
      "$type": "typography",
      "$description": "Meta, captions, strikethrough prices",
      "desktop": {
        "$value": {
          "fontFamily": "{font.text}",
          "fontSize": "13px",
          "fontWeight": 400,
          "lineHeight": 1.2,
          "letterSpacing": "-0.02em"
        }
      },
      "mobile": {
        "$value": {
          "fontFamily": "{font.text}",
          "fontSize": "13px",
          "fontWeight": 400,
          "lineHeight": 1.2,
          "letterSpacing": "-0.02em"
        }
      }
    }
  },
  "tag": {
    "lg": {
      "$type": "typography",
      "$description": "Filter pills",
      "$value": {
        "fontFamily": "{font.text}",
        "fontSize": "14px",
        "fontWeight": 500,
        "lineHeight": 1.0,
        "letterSpacing": "-0.02em"
      }
    },
    "md": {
      "$type": "typography",
      "$description": "On-image badges",
      "$value": {
        "fontFamily": "{font.text}",
        "fontSize": "13px",
        "fontWeight": 600,
        "lineHeight": 1.0,
        "letterSpacing": "-0.02em"
      }
    },
    "sm": {
      "$type": "typography",
      "$description": "Inline tags (nav, price)",
      "$value": {
        "fontFamily": "{font.text}",
        "fontSize": "12px",
        "fontWeight": 600,
        "lineHeight": 1.0,
        "letterSpacing": "-0.02em"
      }
    },
    "category": {
      "urgency": {
        "fill": {
          "$type": "color",
          "$value": "{color.burgundy}"
        },
        "text": {
          "$type": "color",
          "$value": "{color.white}"
        },
        "$description": "Time-bound only. Burgundy only.",
        "$extensions": {
          "com.ecoy": {
            "examples": [
              "Last chance",
              "Sale",
              "Low stock"
            ],
            "source": "spec §01"
          }
        }
      },
      "value": {
        "fill": {
          "$type": "color",
          "$value": "{color.bright-orange}"
        },
        "text": {
          "$type": "color",
          "$value": "{color.white}"
        },
        "$description": "Commercial benefit only. Bright Orange only. White text is the brand exception (3.0:1); use charcoal text where legibility is critical.",
        "$extensions": {
          "com.ecoy": {
            "examples": [
              "30% off",
              "Best seller"
            ],
            "source": "spec §01"
          }
        }
      },
      "newness": {
        "fill": {
          "$type": "color",
          "$value": "{color.deep-green}"
        },
        "text": {
          "$type": "color",
          "$value": "{color.white}"
        },
        "$description": "New products or colourways. Deep Green only. Consolidate from the current orange/burgundy split.",
        "$extensions": {
          "com.ecoy": {
            "examples": [
              "New",
              "New colours"
            ],
            "source": "spec §01"
          }
        }
      },
      "filter": {
        "fill": {
          "$type": "color",
          "$value": "{color.neutral-fill}"
        },
        "text": {
          "$type": "color",
          "$value": "{color.charcoal}"
        },
        "active-fill": {
          "$type": "color",
          "$value": "{color.deep-green}"
        },
        "active-text": {
          "$type": "color",
          "$value": "{color.white}"
        },
        "$description": "Interactive pills for browsing. Never a badge, never carries urgency or value copy.",
        "$extensions": {
          "com.ecoy": {
            "examples": [
              "Sheets",
              "Quilts",
              "Best Sellers"
            ],
            "source": "spec §01"
          }
        }
      }
    },
    "padding": {
      "badge": {
        "$type": "dimension",
        "$value": "6px 14px"
      },
      "inline": {
        "$type": "dimension",
        "$value": "4px 10px"
      },
      "filter": {
        "$type": "dimension",
        "$value": "10px 20px"
      }
    }
  },
  "radius": {
    "badge": {
      "$type": "dimension",
      "$value": "8px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    },
    "card": {
      "$type": "dimension",
      "$value": "24px"
    },
    "card-sm": {
      "$type": "dimension",
      "$value": "16px"
    },
    "button": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "24px"
    },
    "6": {
      "$type": "dimension",
      "$value": "32px"
    },
    "7": {
      "$type": "dimension",
      "$value": "48px"
    },
    "8": {
      "$type": "dimension",
      "$value": "64px"
    },
    "9": {
      "$type": "dimension",
      "$value": "96px"
    }
  },
  "motion": {
    "ease": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.4, 0, 0.2, 1)",
      "$extensions": {
        "com.ecoy": {
          "status": "tbc",
          "source": "guide p33 gives principles, not numbers"
        }
      }
    },
    "ease-out": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0, 0, 0.2, 1)",
      "$extensions": {
        "com.ecoy": {
          "status": "tbc",
          "source": "guide p33 gives principles, not numbers"
        }
      }
    },
    "duration-fast": {
      "$type": "duration",
      "$value": "150ms",
      "$extensions": {
        "com.ecoy": {
          "status": "tbc",
          "source": "guide p33 gives principles, not numbers"
        }
      }
    },
    "duration-base": {
      "$type": "duration",
      "$value": "250ms",
      "$extensions": {
        "com.ecoy": {
          "status": "tbc",
          "source": "guide p33 gives principles, not numbers"
        }
      }
    },
    "duration-slow": {
      "$type": "duration",
      "$value": "400ms",
      "$extensions": {
        "com.ecoy": {
          "status": "tbc",
          "source": "guide p33 gives principles, not numbers"
        }
      }
    }
  },
  "pairing": {
    "green-lightgreen": {
      "ground": {
        "$type": "color",
        "$value": "{color.deep-green}"
      },
      "accents": [
        {
          "$type": "color",
          "$value": "{color.light-green}"
        }
      ],
      "$extensions": {
        "com.ecoy": {
          "source": "guide p18"
        }
      }
    },
    "burgundy-pink-orange": {
      "ground": {
        "$type": "color",
        "$value": "{color.burgundy}"
      },
      "accents": [
        {
          "$type": "color",
          "$value": "{color.light-pink}"
        },
        {
          "$type": "color",
          "$value": "{color.bright-orange}"
        }
      ],
      "$extensions": {
        "com.ecoy": {
          "source": "guide p18"
        }
      }
    },
    "lightblue-deepblue": {
      "ground": {
        "$type": "color",
        "$value": "{color.light-blue}"
      },
      "accents": [
        {
          "$type": "color",
          "$value": "{color.deep-blue}"
        }
      ],
      "$extensions": {
        "com.ecoy": {
          "source": "guide p18"
        }
      }
    },
    "chocolate-pink": {
      "ground": {
        "$type": "color",
        "$value": "{color.chocolate}"
      },
      "accents": [
        {
          "$type": "color",
          "$value": "{color.light-pink}"
        }
      ],
      "$extensions": {
        "com.ecoy": {
          "source": "guide p18"
        }
      }
    },
    "lightgreen-deepblue-green": {
      "ground": {
        "$type": "color",
        "$value": "{color.light-green}"
      },
      "accents": [
        {
          "$type": "color",
          "$value": "{color.deep-blue}"
        },
        {
          "$type": "color",
          "$value": "{color.deep-green}"
        }
      ],
      "$extensions": {
        "com.ecoy": {
          "source": "guide p18"
        }
      }
    },
    "orange-burgundy": {
      "ground": {
        "$type": "color",
        "$value": "{color.bright-orange}"
      },
      "accents": [
        {
          "$type": "color",
          "$value": "{color.burgundy}"
        }
      ],
      "$extensions": {
        "com.ecoy": {
          "source": "guide p18"
        }
      }
    },
    "deepblue-lightblue": {
      "ground": {
        "$type": "color",
        "$value": "{color.deep-blue}"
      },
      "accents": [
        {
          "$type": "color",
          "$value": "{color.light-blue}"
        }
      ],
      "$extensions": {
        "com.ecoy": {
          "source": "guide p18"
        }
      }
    },
    "pink-burgundy-chocolate": {
      "ground": {
        "$type": "color",
        "$value": "{color.light-pink}"
      },
      "accents": [
        {
          "$type": "color",
          "$value": "{color.burgundy}"
        },
        {
          "$type": "color",
          "$value": "{color.chocolate}"
        }
      ],
      "$extensions": {
        "com.ecoy": {
          "source": "guide p18"
        }
      }
    },
    "offwhite-charcoal": {
      "ground": {
        "$type": "color",
        "$value": "{color.off-white}"
      },
      "accents": [
        {
          "$type": "color",
          "$value": "{color.charcoal}"
        }
      ],
      "$extensions": {
        "com.ecoy": {
          "source": "guide p18"
        }
      }
    },
    "charcoal-offwhite": {
      "ground": {
        "$type": "color",
        "$value": "{color.charcoal}"
      },
      "accents": [
        {
          "$type": "color",
          "$value": "{color.off-white}"
        }
      ],
      "$extensions": {
        "com.ecoy": {
