  "glossary": {
    "Concept": {
      "Untested": "New concept being tested for the first time",
      "Iteration": "Building on something that's previously worked",
      "WinnerClone": "Near-direct rebuild of a current winner (different creator, same hook)",
      "TopOfFunnelTest": "Broad/awareness-stage test, usually unaware audience",
      "Refresh": "Existing winner refreshed for fatigue (creative edited, hook preserved)"
    },
    "AwarenessStage": {
      "Unaware": "Doesn't know they have a problem",
      "Problemaware": "Knows the problem; doesn't know solutions exist",
      "Solutionaware": "Knows solutions exist; doesn't know us",
      "Productaware": "Knows us; hasn't committed",
      "Mostaware": "Knows us; just needs the nudge",
      "Brandaware": "Already a customer or brand-familiar (legacy term — equivalent to Productaware)"
    },
    "Persona": {
      "HomeInterior": "Aesthetics-first buyer — cares how it looks in the room",
      "FitnessRecovery": "Buyer who frames sleep as recovery / performance",
      "HotSleeper": "Runs hot at night, primary problem is temperature",
      "SleepGeneral": "Generic sleep-quality buyer, no specific sub-need",
      "PetHair": "Dealing with pet hair / pet-on-bed concerns",
      "CoupleSleeper": "Couples / sleep-disturbed-by-partner messaging",
      "Eco": "Eco-conscious / sustainability-led buyer",
      "Allergies": "Allergy / sensitive-skin angle"
    },
    "Angle": {
      "USP": "Unique selling proposition — product feature claim",
      "ProblemHighlight": "Lead with the problem the product solves",
      "SocialProof": "Reviews, ratings, customer counts, press mentions",
      "Origin": "Founder story, why we built this",
      "ComparisonClaim": "vs cotton / vs competitor / vs old sheets",
      "ValueStack": "What you get for the price",
      "Education": "Teaching about the category (e.g. how bamboo works)",
      "Aspiration": "Lifestyle dream-state, no explicit claim",
      "Urgency": "Scarcity / time-limited / FOMO",
      "Trust": "Warranties, returns, expert endorsement",
      "PriceLed": "Price / discount is the headline",
      "BundleLed": "Bundle savings / value-stacking"
    },
    "Vehicle": {
      "UGC": "User-generated content style, casual smartphone-ish",
      "FounderPOV": "Founder talking to camera",
      "Lifestyle": "Aspirational, polished lifestyle imagery",
      "Demo": "Product in action — fold test, drape, feel, performance",
      "Comparison": "Visual side-by-side, before/after, vs other product",
      "Static": "Single image with copy / text overlay",
      "Podcast": "Sit-down interview / podcast-style clip",
      "BroadStory": "Narrative / cinematic story, longer form",
      "Meme": "Humour, cultural-reference, low-fi",
      "Testimonial": "Talking-head customer review",
      "ReviewScroll": "Screen-recording of real reviews",
      "AIGenerated": "Predominantly AI-generated imagery / video",
      "Collab": "Co-created with a creator partner (named in Source)",
      "Stopmotion": "Stop-motion / claymation / hand-animated",
      "Recut": "Recut of existing footage (low-cost variant)"
    },
    "CampaignMoment": {
      "Evergreen": "Always-on, not tied to a specific moment",
      "NewRelease": "Tied to a new product launch",
      "Restock": "Product back in stock",
      "EOFY": "End of financial year sale (June)",
      "BFCM": "Black Friday / Cyber Monday (November)",
      "BlackFriday": "Black Friday / Cyber Monday (November)",
      "CyberMonday": "Black Friday / Cyber Monday (November)",
      "BoxingDay": "Boxing Day sale (December)",
      "MothersDay": "Holiday calendar moments",
      "FathersDay": "Holiday calendar moments",
      "Christmas": "Holiday calendar moments",
